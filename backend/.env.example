NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://shopgo:shopgo_local_only@localhost:5433/shopgo
ALLOWED_ORIGINS=http://localhost:3000
# Replace with a random secret of at least 32 characters. Required even in local mode.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_MODE=local
# Local OTP is returned only in development when explicitly enabled; never enabled in production.
OTP_TTL_SECONDS=180
SESSION_TTL_SECONDS=3600
QUOTE_TTL_SECONDS=300
RESERVATION_TTL_SECONDS=600
PICKUP_TOKEN_TTL_SECONDS=1800
PAYMENT_MODE=disabled
# HMAC key for the local sandbox webhook, never a live payment provider key.
PAYMENT_WEBHOOK_SECRET=replace-with-another-random-secret-32-characters
WORKER_INTERVAL_MS=10000
SEED_ALLOW=false
# Set both values only when a trusted AI service implementing /chat is available.
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters
AI_TIMEOUT_MS=8000
# Thư mục lưu file tải lên; đường dẫn tương đối được tính từ thư mục backend.
UPLOAD_DIR=uploads
